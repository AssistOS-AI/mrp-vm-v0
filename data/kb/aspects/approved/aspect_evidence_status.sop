@aspect_evidence_status text
Use this aspect when the task needs evidence, assumptions, uncertainty markers, or methodological caution around a claim.
@aspect_evidence_status:meta json
{
  "rev": 1,
  "status": "approved",
  "aspect_type": "epistemological",
  "title": "Evidence and assumptions",
  "summary": "Select KUs that act as evidence, assumption notes, method notes, or uncertainty markers for the current task.",
  "priority": 6,
  "domains": ["runtime", "knowledge", "evaluation"],
  "commands": ["planning", "kb", "credibility"],
  "interpreters": ["HumanLikeReasoner", "AdvancedReasoner", "deepLLM"],
