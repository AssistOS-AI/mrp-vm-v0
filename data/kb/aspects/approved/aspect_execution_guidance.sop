@aspect_execution_guidance text
Use this aspect when the task needs operational guidance about how a command, interpreter, or prompt asset should be used in execution.
@aspect_execution_guidance:meta json
{
  "rev": 1,
  "status": "approved",
  "aspect_type": "operational",
  "title": "Execution guidance",
  "summary": "Select KUs that prescribe how to use commands, interpreters, caller profiles, or prompt assets during execution.",
  "priority": 10,
  "domains": ["runtime", "planning", "knowledge"],
  "commands": ["planning", "kb", "analytic-memory", "logic-eval", "js-eval", "template-eval", "credibility"],
